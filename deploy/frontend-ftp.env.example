# Copy to ~/Documents/sma/frontend-ftp.env on the home server (mode 600).
# Never commit the real file.
#
# app.smartseen.co.za is proxied by Cloudflare, which does not forward FTP.
# FTP_HOST must be the origin hostname or IP from Afrihost ClientZone
# (cPanel → FTP Accounts → Configure FTP Client → FTP Server), or a DNS-only
# record such as ftp.smartseen.co.za that points at that origin.

FTP_HOST=''
FTP_PORT=21
FTP_USER='deployment-user@app.smartseen.co.za'
FTP_PASSWORD=''
FTP_REMOTE_DIR='/'
# auto | tls | plain
FTP_TLS=auto
# cPanel certificates often do not match an IP host. Set to 1 to verify.
FTP_TLS_VERIFY=0
# Remove remote files that are not in the new build. Refuses to do this if the
# FTP root looks like a full hosting account (mail, public_html, and so on).
FTP_DELETE_STALE=1
