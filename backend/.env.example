# SmartSeen Backend — copy to .env and set values. Never commit .env.

# Production: set ENVIRONMENT=production and a strong SECRET_KEY (min 32 chars).
# Startup will refuse to run if ENVIRONMENT=production and SECRET_KEY is unchanged.
ENVIRONMENT=development
SECRET_KEY=your-secret-key-min-32-chars
# MYSQL_* when USE_SQLITE=false
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sma

# Optional: use SQLite for local dev (default true)
USE_SQLITE=true

# Security: in production set to your frontend origin(s), comma-separated.
# https://smartseen.co.za and https://*.smartseen.co.za are also always allowed by the API.
# CORS_ORIGINS=https://app.smartseen.co.za,https://smartseen.co.za,http://localhost:5173
CORS_ORIGINS=https://app.smartseen.co.za,https://smartseen.co.za,https://www.smartseen.co.za,http://localhost:5173,http://127.0.0.1:5173

# File upload (optional; defaults shown)
# RECEIPT_MAX_BYTES=10485760
# ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
# RECEIPT_UPLOAD_DIR=/var/sma/receipts

# Auth (optional)
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# Transactional email via AWS SES SMTP (recommended) or any SMTP provider.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USER=  # SES SMTP username
# SMTP_PASSWORD=  # SES SMTP password
# SMTP_FROM_EMAIL=support@smartseen.co.za
# SMTP_FROM_NAME=SmartSeen
# SMTP_FROM=SmartSeen <support@smartseen.co.za>
# EMAIL_FROM_NAME=SmartSeen
# Verify-email links (app origin). FRONTEND_URL is accepted as an alias.
# APP_BASE_URL=https://app.smartseen.co.za
# FRONTEND_URL=https://smartseen.co.za

# Redis (optional). Rate limiting, cache, and Celery email broker.
# Use DB index 1 for SMA if another app already uses /0.
# REDIS_URL=redis://127.0.0.1:6379/1
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Receipt AI (optional)
# OPENAI_API_KEY=
