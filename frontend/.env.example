# SmartSeen Frontend — copy to .env.local for local dev. Never commit .env.local.

# API base URL (no trailing slash). Backend must allow this origin in CORS.
# Production (ngrok): set to the current public API, e.g. https://xxxx.ngrok-free.app/api/v1
# Refresh from the home server with: ./scripts/update-fe-api-from-ngrok.sh
VITE_API_URL=http://localhost:8083/api/v1
